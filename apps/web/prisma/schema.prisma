// Shiva Texyarn Limited — Enquiry Management System
// Roles: Super Admin (manages team), Managing Director and Accounts (read-only overview),
// Marketing (logs enquiries), Sales (adds pricing / sample / client feedback).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGING_DIRECTOR
  ACCOUNTS
  MARKETING
  SALES
}

/// PLACED  → logged by Marketing, waiting for Sales pricing
/// PRICED  → Sales has added pricing, waiting for client feedback
/// CLOSED  → client feedback recorded, enquiry finished
/// CANCELLED → dropped
enum OrderStatus {
  PLACED
  PRICED
  CLOSED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  /// Company employee code (e.g. ST-014). Optional, unique when set.
  employeeCode String?  @unique @map("employee_code")
  /// Optional contact number.
  phone        String?
  passwordHash String   @map("password_hash")
  role         Role     @default(MARKETING)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResetToken     String?   @unique @map("password_reset_token")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  createdOrders  Order[]                @relation("OrderCreatedBy")
  assignedOrders Order[]                @relation("OrderAssignedTo")
  pricedOrders   Order[]                @relation("OrderPricedBy")
  loginSessions  UserLoginSession[]
  timelineEvents EnquiryTimelineEvent[] @relation("TimelineEventActor")
  auditLogs      AuditLog[]
  notifications  Notification[]

  /// Divisions this person may work in (assigned by Super Admin).
  divisions              UserDivision[]
  divisionAccessRequests DivisionAccessRequest[] @relation("AccessRequestUser")
  divisionAccessDecided  DivisionAccessRequest[] @relation("AccessRequestDecidedBy")
}

model UserLoginSession {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  sessionId   String    @unique @map("session_id") @db.Uuid
  loggedInAt  DateTime  @default(now()) @map("logged_in_at")
  loggedOutAt DateTime? @map("logged_out_at")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent") @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loggedInAt(sort: Desc)])
  @@map("user_login_sessions")
}

/// Business divisions (Lamination, Coating, Garments, Processing, ...). Managed by Super Admin.
model Division {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  users          UserDivision[]
  accessRequests DivisionAccessRequest[]
}

/// Which divisions a Marketing / Sales person can see and work in.
model UserDivision {
  userId     Int      @map("user_id")
  divisionId Int      @map("division_id")
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@id([userId, divisionId])
  @@map("user_divisions")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A Marketing / Sales person asks for access to another division; only Super Admin decides.
model DivisionAccessRequest {
  id          Int                 @id @default(autoincrement())
  userId      Int                 @map("user_id")
  divisionId  Int                 @map("division_id")
  reason      String              @db.Text
  status      AccessRequestStatus @default(PENDING)
  decidedById Int?                @map("decided_by_id")
  decidedAt   DateTime?           @map("decided_at")
  decisionNote String?            @map("decision_note") @db.Text
  createdAt   DateTime            @default(now()) @map("created_at")

  user      User     @relation("AccessRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("AccessRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  division  Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("division_access_requests")
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique @map("order_number")
  status      OrderStatus @default(PLACED)

  /// Date the client enquired (editable, defaults to today).
  enquiryDate DateTime @default(now()) @map("enquiry_date")

  // Customer
  customerName    String  @map("customer_name")
  companyName     String? @map("company_name")
  customerPhone   String? @map("customer_phone")
  customerEmail   String? @map("customer_email")
  customerAddress String? @map("customer_address") @db.Text
  gstNumber       String? @map("gst_number")
  gstCopyUrl      String? @map("gst_copy_url") @db.Text

  // What the client wants (any division — no product-type assumptions)
  divisionId     Int     @map("division_id")
  productDetails String? @map("product_details") @db.Text

  // Sample
  isSample           Boolean   @default(false) @map("is_sample")
  sampleSentAt       DateTime? @map("sample_sent_at")
  sampleCourierName  String?   @map("sample_courier_name")
  sampleTrackingId   String?   @map("sample_tracking_id")
  sampleRemarks      String?   @map("sample_remarks") @db.Text

  // Pricing (added by Sales)
  pricePerUnit  Decimal?  @map("price_per_unit") @db.Decimal(14, 2)
  priceUnit     String?   @map("price_unit")
  quantity      String?
  paymentTerms  String?   @map("payment_terms")
  deliveryTime  String?   @map("delivery_time")
  pricingNotes  String?   @map("pricing_notes") @db.Text
  pricedAt      DateTime? @map("priced_at")
  pricedById    Int?      @map("priced_by_id")

  // Client feedback (recorded by Sales)
  clientFeedback         String?   @map("client_feedback") @db.Text
  clientResponse         String?   @map("client_response") // ACCEPTED | NEGOTIATING | DECLINED
  clientFeedbackAt       DateTime? @map("client_feedback_at")

  cancellationReason String?   @map("cancellation_reason") @db.Text
  closedAt           DateTime? @map("closed_at")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdById  Int  @map("created_by_id")
  assignedToId Int? @map("assigned_to_id")

  division   Division @relation(fields: [divisionId], references: [id])
  createdBy  User     @relation("OrderCreatedBy", fields: [createdById], references: [id])
  assignedTo User?    @relation("OrderAssignedTo", fields: [assignedToId], references: [id])
  pricedBy   User?    @relation("OrderPricedBy", fields: [pricedById], references: [id])

  timelineEvents EnquiryTimelineEvent[]

  @@index([status])
  @@index([divisionId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([enquiryDate(sort: Desc)])
  @@index([status, enquiryDate(sort: Desc)])
}

/// Human-readable history shown on each enquiry.
model EnquiryTimelineEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  type      String
  title     String
  detail    String?  @db.Text
  actorId   Int?     @map("actor_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation("TimelineEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("enquiry_timeline_events")
}

/// Who did what, and when. Shown to the Super admin on the Audit log screen.
/// userName / userRole are snapshots so history stays readable after a person is deleted.
model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  userName    String   @map("user_name")
  userRole    String?  @map("user_role")
  /// AUTH | ENQUIRY | TEAM | DIVISION | ACCESS
  category    String
  /// e.g. ENQUIRY_CREATED, PRICING_ADDED, LOGIN
  action      String
  entityType  String?  @map("entity_type")
  entityId    Int?     @map("entity_id")
  entityLabel String?  @map("entity_label")
  detail      String?  @db.Text
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// In-app notifications shown under the bell in the header.
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String
  title     String
  body      String   @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}
