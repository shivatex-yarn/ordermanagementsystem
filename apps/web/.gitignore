# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# user-uploaded artifacts — must never be committed.
# All uploads (GST certificates, sample proofs, etc.) are stored as JSON/base64
# in the database. If any code path ever writes to disk under public/uploads/
# again it is considered a bug; this rule keeps stray files out of the repo.
/public/uploads/
